generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  PL // Paid Leave
  GL // General Leave
  SL // Sick Leave
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  name         String
  role         Role           @default(STAFF)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  staffProfile  StaffProfile?
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  documents     StaffDocument[]
  salarySlips   SalarySlip[]
}

model StaffProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId        String? @unique
  phone             String?
  department        String?
  isActive          Boolean @default(true)
  avatarPath        String?
  bankAccountHolder String?
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  branchName        String?
}

model StaffDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  fileName  String
  filePath  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SalarySlip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  fileName  String
  filePath  String
  netPay    Float?
  createdAt DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  breaks     Break[]

  @@unique([userId, date])
  @@index([date])
}

model Break {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime?
  createdAt    DateTime   @default(now())

  @@index([attendanceId])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(GL)
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([type])
}

/// Singleton-style leave policy (use id = "default")
model LeavePolicy {
  id            String   @id @default("default")
  plPerMonth    Float    @default(1.5)
  plPerYear     Float    @default(18)
  /// Unused PL carries month-to-month within the year, then stalls (no carry to next year) after this month (1–12)
  yearEndMonth  Int      @default(12)
  updatedAt     DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}
